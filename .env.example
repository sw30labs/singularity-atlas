# Copy to .env (ignored by git). config.py reads it; real environment variables win.

# Default: local Ollama, nothing leaves this machine.
# ATLAS_LLM_PROVIDER=ollama
# ATLAS_MODEL=qwen3.8:27b-mtp-bf16

# OpenAI — headlines and summaries are sent to the API:
# ATLAS_LLM_PROVIDER=openai
# ATLAS_OPENAI_MODEL=gpt-6-luna
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
